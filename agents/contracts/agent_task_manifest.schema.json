{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BYAR BARBER agent dispatch manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","status","canonical_child_id","umbrella_id","milestone_id","issue_number","engine","provider","repository","base_sha","scope_evidence","dispatch_authorized"],
  "properties": {
    "schema_version": {"const":"1.0"},
    "status": {"const":"APPROVED_FOR_RUN"},
    "canonical_child_id": {"type":"string","pattern":"^CI-[A-Za-z0-9-]+$"},
    "umbrella_id": {"type":"string","pattern":"^UMB-M[0-9]{2}$"},
    "milestone_id": {"type":"string","pattern":"^M[0-9]{2}$"},
    "issue_number": {"type":"integer","minimum":1},
    "engine": {"enum":["opencode","mini-swe"]},
    "provider": {"const":"github"},
    "repository": {"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "base_sha": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "scope_evidence": {"type":"array","minItems":2,"maxItems":2,"items":{"type":"object","required":["local_id","scope_revision","scope_sha256","approved_by","evidence_url"]}},
    "dispatch_authorized": {"const":true}
  }
}
